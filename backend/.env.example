# ============================================
# Banking Cloud Log Analyser - Configuration
# Copy this file to .env and fill in your values
# ============================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/banking_log_analyser
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/banking_log_analyser

# --- GCP / Vertex AI ---
GOOGLE_APPLICATION_CREDENTIALS=../service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- SMTP Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_TO_EMAIL=production-manager@company.com

# --- Scheduler ---
SCHEDULER_INTERVAL_MINUTES=5

# --- Export ---
EXPORT_DIR=./exports

# --- App ---
APP_NAME=Banking Cloud Log Analyser
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
