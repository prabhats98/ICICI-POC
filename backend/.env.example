# ============================================
# Azure Incident Log Pipeline — Configuration
# Copy this file to .env and fill in your values.
# The app reads every setting from this file.
# ============================================

# --- App ---
APP_NAME=Azure Incident Log Pipeline
APP_VERSION=2.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (Azure Database for PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://admin:password@your-server.postgres.database.azure.com:5432/incident_pipeline
DATABASE_SYNC_URL=postgresql://admin:password@your-server.postgres.database.azure.com:5432/incident_pipeline

# --- Azure Subscription & Auth ---
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# --- Azure Log Sources (resource IDs) ---
AZURE_FRONTDOOR_RESOURCE_ID=/subscriptions/xxx/resourceGroups/xxx/providers/Microsoft.Cdn/profiles/your-frontdoor
AZURE_APPGATEWAY_RESOURCE_ID=/subscriptions/xxx/resourceGroups/xxx/providers/Microsoft.Network/applicationGateways/your-appgw
AZURE_APIM_RESOURCE_ID=/subscriptions/xxx/resourceGroups/xxx/providers/Microsoft.ApiManagement/service/your-apim
AZURE_VM_RESOURCE_ID=/subscriptions/xxx/resourceGroups/xxx/providers/Microsoft.Compute/virtualMachines/your-vm
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-log-analytics-workspace-id

# --- GCP / Vertex AI (Gemini) ---
GOOGLE_APPLICATION_CREDENTIALS=../service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- Scheduler ---
SCHEDULER_INTERVAL_HOURS=6
SCHEDULER_ENABLED=true

# --- Pipeline Control ---
PIPELINE_ENABLED=true

# --- Notification Channel: "smtp" or "azure_communication_service" ---
NOTIFICATION_CHANNEL=smtp

# --- Azure Communication Services Email ---
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-acs.communication.azure.com/;accesskey=your-key
AZURE_COMMUNICATION_SENDER=DoNotReply@your-domain.azurecomm.net

# --- SMTP Email (fallback) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_TO_EMAIL=production-manager@company.com

# --- Export ---
EXPORT_DIR=./exports
